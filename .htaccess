# Full Circle CMS — Apache / LiteSpeed rules
#
# These rules work for any domain: the site redirects www.example.com to
# example.com and plain http to https using whatever host the visitor used.
# If other websites live in folders inside this one (subdomains on cPanel),
# see "Subdomains in subfolders" in README.md.

Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pass the Authorization header through to PHP
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Never touch SSL certificate checks (Let's Encrypt / cPanel AutoSSL)
  RewriteRule ^\.well-known/ - [L]

  # Always use https:// without www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Private folders and files that are only for setting up the site
  RewriteRule ^(content|data|lib|tools|vendor|backups)(/|$) - [F,L]
  RewriteRule ^composer\.(json|lock)$ - [F,L]
  RewriteRule (^|/)\. - [F,L]
  RewriteRule (^|/)error_log$ - [F,L]
  RewriteRule ^(README\.md|OWNER-GUIDE\.md|router\.php)$ - [F,L]

  # Real files (CSS, images, the control panel) are served directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !^/index\.php/
  RewriteRule ^ - [L]

  # Everything else goes to the site
  RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>

AddType font/woff2 .woff2

# On cPanel, the PHP version block cPanel adds below this line is fine to keep.
